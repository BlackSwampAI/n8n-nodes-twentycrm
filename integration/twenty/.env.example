# Copying this file is optional; `npm run twenty:start` generates a private `.env`.
TWENTY_PORT=3020
PG_DATABASE_USER=twenty_local
PG_DATABASE_PASSWORD=local-config-validation-only
ENCRYPTION_KEY=local-config-validation-only-32-bytes
APP_SECRET=local-config-validation-only-32-bytes

# After creating a key in the local Twenty UI, add it only to integration/twenty/.env:
# TWENTY_API_KEY=replace_with_local_key
