{
	"name": "@blackswampai/n8n-nodes-twentycrm",
	"version": "0.1.4",
	"packageManager": "npm@11.19.0",
	"description": "n8n community integration for Twenty CRM",
	"license": "MIT",
	"homepage": "https://blackswampai.com/n8n-nodes/twenty-crm/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"twenty",
		"twenty-crm",
		"crm"
	],
	"author": {
		"name": "Christopher J. Nelson",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlackSwampAI/n8n-nodes-twentycrm.git"
	},
	"bugs": {
		"url": "https://github.com/BlackSwampAI/n8n-nodes-twentycrm/issues"
	},
	"scripts": {
		"build": "node scripts/clean.mjs && n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
		"format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"twenty:start": "node scripts/twenty-harness.mjs start",
		"twenty:wait": "node scripts/twenty-harness.mjs wait",
		"twenty:stop": "node scripts/twenty-harness.mjs stop",
		"twenty:clean": "node scripts/twenty-harness.mjs clean",
		"twenty:logs": "node scripts/twenty-harness.mjs logs",
		"test:integration": "npm run build && node scripts/twenty-live-test.mjs",
		"test:webhook-bridge": "node scripts/twenty-webhook-qualify.mjs",
		"package:check": "node scripts/package-check.mjs",
		"smoke:load": "node scripts/node-load-smoke.mjs",
		"smoke:install": "node scripts/package-install-smoke.mjs",
		"scan:source": "node scripts/scan-source.mjs",
		"scan:published": "node scripts/scan-published.mjs",
		"test:load": "npm run smoke:load",
		"release:check": "node scripts/release-check.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TwentyApi.credentials.js",
			"dist/credentials/TwentyWebhookApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Twenty/Twenty.node.js",
			"dist/nodes/Twenty/TwentyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.45.4",
		"@n8n/scan-community-package": "0.34.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "20.2.0",
		"typescript": "5.9.2",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"allowScripts": {
		"eslint-plugin-n8n-nodes-base": false
	}
}
