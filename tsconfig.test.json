{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"sourceMap": false,
		"target": "es2022",
		"lib": ["es2022"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"types": ["node", "vitest/globals"]
	},
	"include": [
		"credentials/**/*",
		"nodes/**/*",
		"scripts/**/*.test.ts",
		"scripts/prepare-npm-auth.mjs",
		"scripts/scan-policy.mjs",
		"vitest.config.mts"
	],
	"exclude": []
}
